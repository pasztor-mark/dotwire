{
  "name": "@dotwire/react",
  "version": "0.2.0",
  "description": "React hooks and provider for @dotwire/client: DotwireProvider, useRoom, useTyping, usePresence, useConnectionState.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasztor-mark/dotwire.git",
    "directory": "packages/react"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js"
  },
  "keywords": [
    "dotwire",
    "chat",
    "sdk",
    "react",
    "hooks",
    "signalr"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "peerDependencies": {
    "react": ">=18",
    "@dotwire/client": "*"
  },
  "devDependencies": {
    "@dotwire/client": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  }
}
