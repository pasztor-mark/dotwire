<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Dotwire</RootNamespace>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include=".agents\" />
      <Folder Include=".reminders\" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="dotwire.Tests" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Migrations\**\*.sql" />
    </ItemGroup>

    <ItemGroup>
      <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="DotNetEnv" Version="3.2.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
      <PackageReference Include="NATS.Net" Version="3.4.1" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
    </ItemGroup>

</Project>
