# Copy to .env and fill in real values. .env is gitignored; this file is the template.
POSTGRES_PASSWORD=            # migrator/owner role (user: dotwire) — migrations only
POSTGRES_APP_PASSWORD=        # runtime role (user: dotwire_app), created by migration 0001

# At-rest encryption (AES-256-GCM), base64 32-byte key. Generate: openssl rand -base64 32
Dotwire__Encryption__ActiveKeyId=k1
Dotwire__Encryption__Keys__k1=

# Local dev (dotnet run): loaded by DotNetEnv, mapped to .NET config via __ = :
ConnectionStrings__PostgresMigrator="Host=localhost;Port=5432;Database=dotwire;Username=dotwire;Password=${POSTGRES_PASSWORD}"
ConnectionStrings__PostgresWrite="Host=localhost;Port=5432;Database=dotwire;Username=dotwire_app;Password=${POSTGRES_APP_PASSWORD}"
ConnectionStrings__PostgresRead="Host=localhost;Port=5432;Database=dotwire;Username=dotwire_app;Password=${POSTGRES_APP_PASSWORD}"
Postgres__AppRolePassword="${POSTGRES_APP_PASSWORD}"
Nats__Url=nats://localhost:4222
Dotwire__Role=All

# --- Host JWT verification (AUTH.md) -------------------------------------------
# dotwire verifies RS256 tokens minted by the HOST; it holds public keys only.
# Generate a dev keypair (private key stays outside dotwire — it plays the host):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out dev-jwt.key
#   openssl pkey -in dev-jwt.key -pubout
# Paste the PUBLIC key below; DotNetEnv understands \n escapes in double quotes.
Auth__Issuer=dev-host
Auth__Audience=dotwire
Auth__Keys__dev="-----BEGIN PUBLIC KEY-----\n...paste...\n-----END PUBLIC KEY-----"

# --- Optional: webhooks, SSE, rate limits, retention (defaults need nothing set) ---------
# Presend: synchronous, blocking call before a send is accepted. Unset = off.
# Dotwire__Webhooks__Presend__Url=https://my-host.example.com/webhooks/dotwire/presend
# Dotwire__Webhooks__Presend__TimeoutMs=500
# Dotwire__Webhooks__Presend__FailPolicy=Closed          # Closed | Open
# Dotwire__Webhooks__Presend__IncludeAdminSends=false
# Postsend: async, queued call-out after a send is accepted. Unset = off.
# Dotwire__Webhooks__PostSend__Url=https://my-host.example.com/webhooks/dotwire/postsend
# Dotwire__Webhooks__PostSend__TimeoutMs=2000
# Dotwire__Webhooks__PostSend__MaxAttempts=3
# Dotwire__Webhooks__PostSend__QueueCapacity=10000
# Dotwire__Webhooks__PostSend__IncludeAdminSends=false
# Shared HMAC secret; when set, both webhook calls carry X-Dotwire-Signature: sha256=<hex>.
# Dotwire__Webhooks__Secret=

# SSE read path (GET /rooms/{roomId}/events). On by default.
# Dotwire__Sse__Enabled=true
# Dotwire__Sse__KeepAliveSeconds=15
# Dotwire__Sse__BufferSize=256
# Dotwire__Sse__ReplayPageSize=100

# Per-node token-bucket rate limits. On by default.
# Dotwire__RateLimits__Enabled=true
# Dotwire__RateLimits__Send__PermitLimit=20
# Dotwire__RateLimits__Read__PermitLimit=30
# Dotwire__RateLimits__Admin__PermitLimit=200
# Dotwire__RateLimits__Hub__PermitLimit=30

# Postgres message retention (Timescale chunk drops). Unset = indefinite. Manage this via
# config OR the admin API/SDK, not both.
# Dotwire__Retention__MessagesDays=90
