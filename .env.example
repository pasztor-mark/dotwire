# Copy to .env and fill in real values. .env is gitignored; this file is the template.
POSTGRES_PASSWORD=            # migrator/owner role (user: dotwire) — migrations only
POSTGRES_APP_PASSWORD=        # runtime role (user: dotwire_app), created by migration 0001

# At-rest encryption (AES-256-GCM), base64 32-byte key. Generate: openssl rand -base64 32
Dotwire__Encryption__ActiveKeyId=k1
Dotwire__Encryption__Keys__k1=

# Local dev (dotnet run): loaded by DotNetEnv, mapped to .NET config via __ = :
ConnectionStrings__PostgresMigrator="Host=localhost;Port=5432;Database=dotwire;Username=dotwire;Password=${POSTGRES_PASSWORD}"
ConnectionStrings__PostgresWrite="Host=localhost;Port=5432;Database=dotwire;Username=dotwire_app;Password=${POSTGRES_APP_PASSWORD}"
ConnectionStrings__PostgresRead="Host=localhost;Port=5432;Database=dotwire;Username=dotwire_app;Password=${POSTGRES_APP_PASSWORD}"
Postgres__AppRolePassword="${POSTGRES_APP_PASSWORD}"
Nats__Url=nats://localhost:4222
Dotwire__Role=All

# --- Host JWT verification (AUTH.md) -------------------------------------------
# dotwire verifies RS256 tokens minted by the HOST; it holds public keys only.
# Generate a dev keypair (private key stays outside dotwire — it plays the host):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out dev-jwt.key
#   openssl pkey -in dev-jwt.key -pubout
# Paste the PUBLIC key below; DotNetEnv understands \n escapes in double quotes.
Auth__Issuer=dev-host
Auth__Audience=dotwire
Auth__Keys__dev="-----BEGIN PUBLIC KEY-----\n...paste...\n-----END PUBLIC KEY-----"
